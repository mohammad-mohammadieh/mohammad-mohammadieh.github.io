---
// Fixed text, shown on every project page above any image.
// A project can add one sentence through `noteExtra`. It cannot replace the text.
import { site } from "../data/site";

interface Props {
  extra?: string;
}

const { extra } = Astro.props;
---

<aside class="note" aria-labelledby="note-label">
  <p>
    <strong id="note-label">About this page.</strong>{" "}
    {site.confidentialityNote}
    {extra && ` ${extra}`}
  </p>
</aside>
