---
// Fixed text, shown on every project page above any image.
// A project can add one sentence through `noteExtra` when accuracy needs it. It cannot replace the text.
import { site } from "../data/site";

interface Props {
  extra?: string;
}

const { extra } = Astro.props;
---

<aside class="note" aria-label="Confidentiality">
  <p>
    {site.confidentialityNote}
    {extra && ` ${extra}`}
  </p>
</aside>
