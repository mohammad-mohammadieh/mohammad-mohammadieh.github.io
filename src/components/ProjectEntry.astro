---
// One project card on the home page. Every card has the same parts in the same
// order: hero image, number, title, one line, one headline number, tool tags.
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import MediaSlot from "./MediaSlot.astro";
import { ROLE_LABEL, STATUS_LABEL, projectHref, type Project } from "../lib/projects";

interface Props {
  project: Project;
  number: string;
  /** Hold the picture area with an empty frame when this project has no hero image yet. */
  reserveThumb?: boolean;
}

const { project, number, reserveThumb = false } = Astro.props;
const { data } = project;
const cover = data.cover;
// The headline number: the first of the figures the project page shows.
const figure = data.figures.find((f) => f.scope === "original");
const thumbWidths = cover ? [480, 640, 960].filter((w) => w <= cover.src.width) : [];
// Shown only when there is something to say: team work, or media still to come.
const notes = [
  data.role === "contributed" ? ROLE_LABEL[data.role] : null,
  data.status !== "media" ? STATUS_LABEL[data.status] : null,
].filter((note) => note !== null);
---

<article class="entry">
  {
    cover ? (
      <div class="entry__thumb">
        <Image
          src={cover.src}
          alt={cover.alt}
          format="webp"
          quality={82}
          width={thumbWidths.at(-1) ?? cover.src.width}
          widths={thumbWidths.length ? thumbWidths : [cover.src.width]}
          sizes="(min-width: 1000px) 424px, (min-width: 600px) 50vw, calc(100vw - 48px)"
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      reserveThumb && (
        <div class="entry__thumb entry__thumb--empty" aria-hidden="true">
          <MediaSlot kind="screen" label="Media coming soon" />
        </div>
      )
    )
  }
  <div class="entry__body">
    <p class="entry__num">{number}</p>
    <h3 class="entry__title">
      <a href={projectHref(project)}>
        {data.title}<Icon name="arrow-right" class="entry__arrow" />
      </a>
    </h3>
    <p class="entry__summary">{data.summary}</p>
    {
      figure && (
        <p class="entry__figure">
          <strong>{figure.value}</strong>
          {figure.label}
        </p>
      )
    }
    <div class="entry__foot">
      <ul class="tags" aria-label="Tools">
        {data.stack.map((tool) => <li class="tag">{tool}</li>)}
      </ul>
      {notes.length > 0 && <p class="entry__note">{notes.join(". ")}</p>}
    </div>
  </div>
</article>
