---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import FiguresRow from "./FiguresRow.astro";
import MediaSlot from "./MediaSlot.astro";
import { ROLE_LABEL, STATUS_LABEL, projectHref, type Project } from "../lib/projects";

interface Props {
  project: Project;
  number: string;
  /** The first project is shown full width. */
  feature?: boolean;
  /** Hold the picture area with an empty frame when this project has no hero image yet. */
  reserveThumb?: boolean;
}

const { project, number, feature = false, reserveThumb = false } = Astro.props;
const { data } = project;
const figures = data.figures.filter((f) => f.scope === "original").slice(0, 3);
const cover = data.cover;
const thumbWidths = cover ? [480, 640, 960, 1280].filter((w) => w <= cover.src.width) : [];
---

<article class:list={["entry", { "entry--feature": feature, "entry--media": cover || reserveThumb }]}>
  {
    cover ? (
      <div class="entry__thumb">
        <Image
          src={cover.src}
          alt={cover.alt}
          format="webp"
          quality={82}
          width={thumbWidths.at(-1) ?? cover.src.width}
          widths={thumbWidths.length ? thumbWidths : [cover.src.width]}
          sizes={
            feature
              ? "(min-width: 1000px) 500px, (min-width: 720px) 55vw, calc(100vw - 48px)"
              : "(min-width: 1000px) 412px, (min-width: 720px) 50vw, calc(100vw - 48px)"
          }
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      reserveThumb && (
        <div class="entry__thumb entry__thumb--empty" aria-hidden="true">
          <MediaSlot kind="screen" label="Media coming soon" />
        </div>
      )
    )
  }
  <div class="entry__text">
    <p class="entry__num">{number}</p>
    <h3 class="entry__title">
      <a href={projectHref(project)}>
        {data.title}<Icon name="arrow-right" class="entry__arrow" />
      </a>
    </h3>
    <p class="entry__summary">{data.summary}</p>
  </div>
  {
    figures.length > 0 && (
      <FiguresRow items={figures} label={`${data.title} in numbers`} size="sm" />
    )
  }
  <dl class="entry__meta">
    <div>
      <dt class="visually-hidden">Stack</dt>
      <dd>{data.stack.join(", ")}</dd>
    </div>
    {
      data.role === "contributed" && (
        <div>
          <dt class="visually-hidden">Role</dt>
          <dd>{ROLE_LABEL[data.role]}</dd>
        </div>
      )
    }
    {
      data.status !== "media" && (
        <div>
          <dt class="visually-hidden">Status</dt>
          <dd class="entry__status">{STATUS_LABEL[data.status]}</dd>
        </div>
      )
    }
  </dl>
</article>
