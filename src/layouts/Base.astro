---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  home?: boolean;
  /** The home page section this page belongs to, marked as current in the masthead. */
  section?: string;
  jsonLd?: Record<string, unknown>;
}

const { home = false, section, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...head} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header home={home} current={section} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // 1. Sections below the first screen rise in once as they are reached.
      // 2. On the home page, the masthead link of the section being read is marked.
      // Without this script nothing is hidden and the links still work.
      (() => {
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!calm && "IntersectionObserver" in window) {
          const seen = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.remove("is-pending");
                seen.unobserve(entry.target);
              }
            },
            { rootMargin: "0px 0px -8% 0px" },
          );
          for (const el of document.querySelectorAll("[data-reveal]")) {
            if (el.getBoundingClientRect().top > innerHeight) {
              el.classList.add("is-pending");
              seen.observe(el);
            }
          }
        }

        const masthead = document.querySelector(".masthead[data-spy]");
        if (!masthead) return;
        const links = new Map();
        for (const link of masthead.querySelectorAll('.masthead__nav a[href^="/#"]')) {
          links.set(link.getAttribute("href").slice(2), link);
        }
        const sections = [...document.querySelectorAll("main section[id]")];
        let queued = false;
        const mark = () => {
          queued = false;
          const line = innerHeight * 0.35;
          let current = "";
          for (const section of sections) {
            if (section.getBoundingClientRect().top <= line) current = section.id;
          }
          const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
          if (atEnd && sections.length) current = sections[sections.length - 1].id;
          for (const [id, link] of links) {
            if (id === current) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          }
        };
        const ask = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(mark);
        };
        addEventListener("scroll", ask, { passive: true });
        addEventListener("resize", ask);
        mark();
      })();
    </script>
  </body>
</html>
