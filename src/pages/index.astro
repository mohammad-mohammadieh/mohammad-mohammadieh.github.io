---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import FiguresRow from "../components/FiguresRow.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import Icon from "../components/Icon.astro";
import { site, mailto } from "../data/site";
import { getProjects, projectHref, projectNumber } from "../lib/projects";

const projects = await getProjects();
const bySlug = new Map(projects.map((p) => [p.id, p]));
const [lead, ...rest] = projects;

// Search engines get the same facts the page shows. No employer, no clients.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  url: new URL("/", Astro.site).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.city,
    addressCountry: site.country,
  },
  sameAs: [site.linkedin.url, ...(site.github ? [site.github.url] : [])],
  alumniOf: { "@type": "CollegeOrUniversity", name: site.education.school },
};

const figures = [
  { value: String(projects.length), label: "projects shown on this site" },
  ...site.figures.items,
];
// Once any project has a hero image, the others hold the same space with an empty frame.
const anyCover = projects.some((p) => p.data.cover);
---

<Base title={site.seo.title} description={site.seo.description} jsonLd={jsonLd} home>
  <section class="intro" aria-label="Introduction">
    <div class="wrap section__grid">
      <div class="intro__body">
        <p class="intro__statement">{site.intro.statement}</p>
        {site.intro.paragraphs.map((text) => <p class="intro__text">{text}</p>)}
        <div class="intro__actions">
          <a class="button" href="#projects">See the projects</a>
          <a class="button button--quiet" href={site.resume.href} download type="application/pdf">
            <Icon name="download" />
            {site.resume.label}
          </a>
          <a class="link" href={mailto}>Email</a>
        </div>
        {
          projects.some((p) => p.data.cover) && (
            <nav class="strip" aria-label="Projects at a glance">
              <ul class="strip__list">
                {projects.map(
                  (p, i) =>
                    p.data.cover && (
                      <li>
                        <a class="strip__link" href={projectHref(p)}>
                          <span class="strip__thumb figure__frame">
                            <Image
                              src={p.data.cover.src}
                              alt={p.data.cover.title ?? `${p.data.title}, first screen`}
                              format="webp"
                              quality={80}
                              width={480}
                              widths={[240, 480]}
                              sizes="(min-width: 1000px) 162px, (min-width: 720px) 18vw, 45vw"
                              loading="eager"
                              decoding="async"
                            />
                          </span>
                          <span class="strip__num">{projectNumber(i)}</span>
                          <span class="strip__title">{p.data.title}</span>
                        </a>
                      </li>
                    ),
                )}
              </ul>
            </nav>
          )
        }
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="band-label">
    <div class="wrap section__grid">
      <p class="band__label" id="band-label">{site.figures.label}</p>
      <FiguresRow items={figures} label={site.figures.label} />
    </div>
  </section>

  <Section id="work" number="1" title="Work">
    <div class="jobs">
      {
        site.work.map((job) => (
          <article class="job">
            <header class="job__head">
              <h3 class="job__org">{job.employer}</h3>
              <p class="job__role">{job.role}</p>
              <p class="job__meta">
                <span>{job.location}</span>
                <span>{job.dates}</span>
              </p>
            </header>
            <ul class="job__bullets">
              {job.lines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            {(() => {
              const related = (job.related ?? [])
                .map((slug) => bySlug.get(slug))
                .filter((p) => p !== undefined);
              return (
                related.length > 0 && (
                  <p class="related">
                    <span class="related__label">Case studies</span>
                    <span class="related__links">
                      {related.map((p) => (
                        <a href={projectHref(p)}>{p.data.title}</a>
                      ))}
                    </span>
                  </p>
                )
              );
            })()}
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="projects" number="2" title="Projects">
    <p class="lede">{site.projectsIntro}</p>
    <div class="entries">
      {lead && <ProjectEntry project={lead} number={projectNumber(0)} feature reserveThumb={anyCover} />}
      {
        rest.length > 0 && (
          <div class="entries__grid">
            {rest.map((project, i) => (
              <ProjectEntry project={project} number={projectNumber(i + 1)} reserveThumb={anyCover} />
            ))}
          </div>
        )
      }
    </div>
  </Section>

  <Section id="skills" number="3" title="Skills">
    <dl class="skills">
      {
        site.skills.map((skill) => (
          <div class="skills__row">
            <dt>{skill.group}</dt>
            <dd>{skill.items}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section id="education" number="4" title="Education">
    <article class="job">
      <header class="job__head">
        <h3 class="job__org">{site.education.school}</h3>
        <p class="job__role">{site.education.degree}</p>
        <p class="job__meta">
          <span>{site.education.location}</span>
          <span>{site.education.dates}</span>
        </p>
      </header>
    </article>
  </Section>

  <Section id="contact" number="5" title="Contact">
    <p class="lede">{site.contactLede}</p>
    <dl class="contact">
      <div class="contact__row">
        <dt>Email</dt>
        <dd><a class="link" href={mailto}>{site.email}</a></dd>
      </div>
      <div class="contact__row">
        <dt>LinkedIn</dt>
        <dd>
          <a class="link" href={site.linkedin.url} rel="me noopener">
            {site.linkedin.label}<Icon name="arrow-up-right" />
          </a>
        </dd>
      </div>
      {
        site.github && (
          <div class="contact__row">
            <dt>GitHub</dt>
            <dd>
              <a class="link" href={site.github.url} rel="me noopener">
                {site.github.label}<Icon name="arrow-up-right" />
              </a>
            </dd>
          </div>
        )
      }
    </dl>
  </Section>
</Base>
