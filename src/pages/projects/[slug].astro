---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import FiguresRow from "../../components/FiguresRow.astro";
import ConfidentialityNote from "../../components/ConfidentialityNote.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import MediaArea from "../../components/MediaArea.astro";
import TryIt from "../../components/TryIt.astro";
import Pager from "../../components/Pager.astro";
import Icon from "../../components/Icon.astro";
import { site, mailto } from "../../data/site";
import {
  ROLE_LABEL,
  formatDate,
  getProjects,
  projectNumber,
  splitBody,
  type Project,
} from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  const at = (i: number) =>
    projects[i] ? { project: projects[i], number: projectNumber(i) } : undefined;
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, number: projectNumber(index), prev: at(index - 1), next: at(index + 1) },
  }));
}

interface Neighbor {
  project: Project;
  number: string;
}
interface Props {
  project: Project;
  number: string;
  prev?: Neighbor;
  next?: Neighbor;
}

const { project, number, prev, next } = Astro.props;
const { data } = project;

// Sections 1 to 4 are the written Markdown body. The rest are generated.
const written = splitBody(project.rendered?.html ?? "");
const hasTryIt = Boolean(data.demo || data.repoUrl || data.downloads.length > 0);
// The highlight video opens the page. The walkthrough and the screens follow it.
const highlight = data.videos[0];
const mediaTitle = data.videos.length > 1 ? "Walkthrough and screens" : "Screens";
const sections = [
  { id: "screens", title: mediaTitle },
  ...written,
  ...(hasTryIt ? [{ id: "try-it", title: "Try it" }] : []),
];
const sectionNumber = (id: string) => String(sections.findIndex((s) => s.id === id) + 1);

// Facts about the real project only. Numbers measured on the demo are left to the text.
const originalFigures = data.figures.filter((f) => f.scope === "original").slice(0, 4);

const title = data.seo?.title ?? `${data.title} | ${site.name}`;
const description = data.seo?.description ?? data.summary;
// A per-project social image is used when one has been generated (npm run images).
const ogImage = existsSync(join(process.cwd(), "public", "og", `${project.id}.png`))
  ? `/og/${project.id}.png`
  : "/og-home.png";
---

<Base title={title} description={description} ogImage={ogImage} ogType="article" section="projects">
  <article class="case">
    <header class="case__header">
      <div class="wrap">
        <a class="back" href="/#projects">
          <Icon name="arrow-left" />
          All projects
        </a>

        <div class:list={["case__top", { "case__top--split": highlight }]}>
          <div class="case__intro">
            <p class="case__num">Project {number}</p>
            <h1 class="case__title">{data.title}</h1>
            <p class="case__summary">{data.summary}</p>

            <dl class="case__meta">
              <div>
                <dt>Tools</dt>
                <dd>
                  <ul class="tags">
                    {data.stack.map((tool) => <li class="tag">{tool}</li>)}
                  </ul>
                </dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>{data.roleDetail ?? ROLE_LABEL[data.role]}</dd>
              </div>
            </dl>

            <ConfidentialityNote extra={data.noteExtra} />
          </div>

          {
            (highlight || originalFigures.length > 0) && (
              <div class="case__lead">
                {highlight && <VideoEmbed video={highlight} number={1} />}
                {originalFigures.length > 0 && (
                  <div class="case__figures">
                    <FiguresRow items={originalFigures} label="The project in numbers" size="strip" />
                  </div>
                )}
              </div>
            )
          }
        </div>
      </div>
    </header>

    <Section id="screens" number={sectionNumber("screens")} title={mediaTitle}>
      <MediaArea project={project} skipVideos={highlight ? 1 : 0} />
    </Section>

    {
      written.map((s) => (
        <Section id={s.id} number={sectionNumber(s.id)} title={s.title}>
          <div class="prose" set:html={s.html} />
        </Section>
      ))
    }

    {
      hasTryIt && (
        <Section id="try-it" number={sectionNumber("try-it")} title="Try it">
          <TryIt project={project} />
        </Section>
      )
    }

    <footer class="case__footer">
      <div class="wrap section__grid" data-reveal>
        <div class="case__footer-body">
          <Pager prev={prev} next={next} />
          <p class="case__ask">
            Questions about this project? <a class="link" href={mailto}>Email</a> me.
          </p>
          <p class="case__updated">
            Last updated <time datetime={data.updated.toISOString().slice(0, 10)}
              >{formatDate(data.updated)}</time
            >
          </p>
        </div>
      </div>
    </footer>
  </article>
</Base>
